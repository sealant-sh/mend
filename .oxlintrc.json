{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "promise", "node", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    ".turbo/**",
    ".direnv/**",
    // t3code's contracts, copied verbatim at a pinned tag and never edited (ADR 0012).
    "packages/t3-contracts/src/**",
    "packages/t3-contracts/t3-shared/src/**",
    "packages/t3-contracts/client-runtime/**"
  ],
  "rules": {
    "import/no-cycle": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    // Both mostly flag deliberate Effect patterns. consistent-return flags functions that return on
    // every path of an exhaustive switch, or that end in `return yield*`. no-misused-spread flags
    // deliberate copies of Effect class instances, such as a Schema class spread into a new value.
    "typescript/consistent-return": "off",
    "typescript/no-misused-spread": "off",
    "unicorn/prefer-node-protocol": "error",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_splat", "_tag", "_values"]
      }
    ]
  },
  "overrides": [
    {
      // Every package whose Effect tests run on the shared guard (step 2c). t3-gateway has its own
      // Effect and Vitest and its own guard copy, below.
      "files": [
        "packages/sessions/**/*.{ts,tsx,mts,cts,js,mjs,cjs}",
        "packages/db/**/*.{ts,tsx,mts,cts,js,mjs,cjs}",
        "packages/jobs/**/*.{ts,tsx,mts,cts,js,mjs,cjs}",
        "packages/store/**/*.{ts,tsx,mts,cts,js,mjs,cjs}",
        "apps/api/**/*.{ts,tsx,mts,cts,js,mjs,cjs}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "effect/testing",
                "message": "Import TestClock from @mend/test-ci/effect-vitest so replacement clocks keep the CI warning guard."
              },
              {
                "name": "@effect/vitest",
                "message": "Use @mend/test-ci/effect-vitest so captured TestClock warnings fail the runner; ordinary assertions and hooks come from vitest."
              }
            ],
            "patterns": [
              {
                "group": [
                  "effect/testing/TestClock",
                  "effect/testing/TestClock.*",
                  "effect/testing/index",
                  "effect/testing/index.*"
                ],
                "message": "Import TestClock from @mend/test-ci/effect-vitest so replacement clocks keep the CI warning guard."
              },
              {
                "group": ["@effect/vitest/*"],
                "message": "Use @mend/test-ci/effect-vitest so captured TestClock warnings fail the runner; ordinary assertions and hooks come from vitest."
              }
            ]
          }
        ],
        // no-restricted-imports never sees require(); none of these packages uses CommonJS.
        "import/no-commonjs": "error"
      }
    },
    {
      "files": ["apps/t3-gateway/**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "effect/testing",
                "message": "Import TestClock from test/support/effect-vitest.ts so replacement clocks keep the CI warning guard."
              },
              {
                "name": "@effect/vitest",
                "message": "Use test/support/effect-vitest.ts so captured TestClock warnings fail the runner; ordinary assertions and hooks come from vitest."
              }
            ],
            "patterns": [
              {
                "group": [
                  "effect/testing/TestClock",
                  "effect/testing/TestClock.*",
                  "effect/testing/index",
                  "effect/testing/index.*"
                ],
                "message": "Import TestClock from test/support/effect-vitest.ts so replacement clocks keep the CI warning guard."
              },
              {
                "group": ["@effect/vitest/*"],
                "message": "Use test/support/effect-vitest.ts so captured TestClock warnings fail the runner; ordinary assertions and hooks come from vitest."
              }
            ]
          }
        ],
        // no-restricted-imports never sees require(); none of these packages uses CommonJS.
        "import/no-commonjs": "error"
      }
    },
    {
      // The guard itself wraps the raw entrypoints.
      "files": ["apps/t3-gateway/test/support/effect-vitest.ts"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": ["apps/mobile/src/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@tanstack/react-query",
                "importNames": ["QueryClient", "QueryClientProvider"],
                "allowTypeImports": true,
                "message": "Server data lives in the pairing's client. Render under PairingBoundary (src/data/pairing-scope.tsx) and use useQueryClient(); never make a second client."
              },
              {
                "name": "@tanstack/query-core",
                "importNames": ["QueryClient"],
                "allowTypeImports": true,
                "message": "Server data lives in the pairing's client. Render under PairingBoundary (src/data/pairing-scope.tsx) and use useQueryClient(); never make a second client."
              }
            ],
            "patterns": [
              {
                "regex": "(^|/)machine(\\.[cm]?[jt]sx?)?$",
                "importNames": ["openMachine"],
                "message": "Only the pairing's slot (src/data/pairing-scope.tsx) opens a machine. Take `usePairing().machine` in a hook or component, or a `machine` parameter in a plain function, captured before any await."
              },
              {
                "regex": "(^|/)pairing-config(\\.[cm]?[jt]sx?)?$",
                "importNames": ["loadConfig", "useConfig"],
                "message": "The current pairing is not the pairing that started your work. Take `usePairing().machine` (or `usePairing().config` for what the screen shows), or a `machine` parameter in a plain function."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "checkGlobalObject": true,
            "globals": [
              {
                "name": "fetch",
                "message": "Requests go through the pairing's machine, which carries its address and bearer: `usePairing().machine.read(…)` / `.write(…)`, or a `machine` parameter in a plain function."
              },
              {
                "name": "XMLHttpRequest",
                "message": "Uploads go through the pairing's machine: `usePairing().machine.upload(…)`, or a `machine` parameter in a plain function."
              },
              {
                "name": "WebSocket",
                "message": "The terminal socket is useTtySocket (src/data/tty-socket.ts): it takes its address and bearer from the pairing's machine."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/mobile/src/data/pairing-scope.tsx", "apps/mobile/src/**/*.test.{ts,tsx}"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": [
        "apps/mobile/src/data/machine.ts",
        "apps/mobile/src/data/pairing-client.ts",
        "apps/mobile/src/data/notifications.ts"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "checkGlobalObject": true,
            "globals": [
              {
                "name": "WebSocket",
                "message": "The terminal socket is useTtySocket (src/data/tty-socket.ts): it takes its address and bearer from the pairing's machine."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/mobile/src/data/tty-socket.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "checkGlobalObject": true,
            "globals": [
              {
                "name": "fetch",
                "message": "Requests go through the pairing's machine, which carries its address and bearer: `usePairing().machine.read(…)` / `.write(…)`, or a `machine` parameter in a plain function."
              },
              {
                "name": "XMLHttpRequest",
                "message": "Uploads go through the pairing's machine: `usePairing().machine.upload(…)`, or a `machine` parameter in a plain function."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/mobile/src/**/*.test.{ts,tsx}"],
      "rules": { "no-restricted-globals": "off" }
    },
    {
      "files": ["packages/ui-old/src/components/ui/**"],
      "rules": {
        "no-shadow": "off"
      }
    },
    {
      // The web app, its UI kit, and the desktop Connect/Offline shell on Sheet are held to the
      // rules below; the old kit, marketing and mobile are not.
      // tooling/oxlint-plugin-mend/README.md says what each mend/ rule flags and allows. New code
      // passes them without disable comments.
      "files": [
        "apps/web/**/*.{ts,tsx,mts,cts,js,mjs,cjs}",
        "apps/desktop/src/renderer/**/*.{ts,tsx,mts,cts,js,mjs,cjs}",
        "packages/ui/**/*.{ts,tsx,mts,cts,js,mjs,cjs}"
      ],
      "plugins": ["typescript", "import", "promise", "node", "unicorn", "react", "jsx-a11y"],
      "jsPlugins": [
        { "name": "mend", "specifier": "./tooling/oxlint-plugin-mend/src/index.ts" },
        { "name": "@tanstack/query", "specifier": "@tanstack/eslint-plugin-query" },
        { "name": "@tanstack/router", "specifier": "@tanstack/eslint-plugin-router" }
      ],
      "rules": {
        "mend/query-states": "error",
        "mend/router-default-states": "error",
        "mend/no-raw-colors": "error",
        "mend/no-arbitrary-type-or-radius": "error",
        "mend/no-use-client": "error",
        "mend/no-effect-fetch": "error",
        "mend/no-state-copy-effect": "error",

        "@tanstack/query/exhaustive-deps": "error",
        "@tanstack/query/no-rest-destructuring": "error",
        "@tanstack/query/stable-query-client": "error",
        "@tanstack/query/no-unstable-deps": "error",
        "@tanstack/query/infinite-query-property-order": "error",
        "@tanstack/query/no-void-query-fn": "error",
        "@tanstack/query/mutation-property-order": "error",
        // Query options come from factories (`sessionsQuery()`, `trpc.x.queryOptions()`), so a
        // component calls useQuery itself and mend/query-states sees what it reads.
        "@tanstack/query/prefer-query-options": "error",
        "@tanstack/router/create-route-property-order": "error",
        "@tanstack/router/route-param-names": "error",

        // An override's plugins don't take the base categories, so each rule is named. The
        // class-component rules are left off: the app has no class components.
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "react/forward-ref-uses-ref": "error",
        "react/jsx-key": "error",
        "react/jsx-no-duplicate-props": "error",
        "react/jsx-no-undef": "error",
        "react/jsx-props-no-spread-multi": "error",
        "react/no-children-prop": "error",
        "react/no-danger-with-children": "error",
        "react/no-render-return-value": "error",
        "react/no-this-in-sfc": "error",
        "react/void-dom-elements-no-children": "error",
        "react/jsx-no-comment-textnodes": "error",
        "react/jsx-no-script-url": "error",
        "react/no-namespace": "error",
        "react/style-prop-object": "error",
        "react/button-has-type": "error",
        "react/no-array-index-key": "error",
        "react/no-unstable-nested-components": "error",
        "react/jsx-no-constructed-context-values": "error",
        "react/no-object-type-as-default-prop": "error",
        "react/checked-requires-onchange-or-readonly": "error",
        "react/no-danger": "error",
        // The JSX transform needs no React in scope.
        "react/react-in-jsx-scope": "off",
        // Session previews frame the person's own dev server, which needs scripts and its own
        // origin together; that is the combination this rule refuses.
        "react/iframe-missing-sandbox": "off",

        "jsx-a11y/alt-text": "error",
        "jsx-a11y/anchor-has-content": "error",
        "jsx-a11y/anchor-is-valid": "error",
        "jsx-a11y/aria-activedescendant-has-tabindex": "error",
        "jsx-a11y/aria-props": "error",
        "jsx-a11y/aria-proptypes": "error",
        "jsx-a11y/aria-role": "error",
        "jsx-a11y/aria-unsupported-elements": "error",
        "jsx-a11y/autocomplete-valid": "error",
        "jsx-a11y/click-events-have-key-events": "error",
        "jsx-a11y/control-has-associated-label": "error",
        "jsx-a11y/heading-has-content": "error",
        "jsx-a11y/html-has-lang": "error",
        "jsx-a11y/iframe-has-title": "error",
        "jsx-a11y/img-redundant-alt": "error",
        "jsx-a11y/interactive-supports-focus": "error",
        "jsx-a11y/label-has-associated-control": "error",
        "jsx-a11y/lang": "error",
        "jsx-a11y/media-has-caption": "error",
        "jsx-a11y/mouse-events-have-key-events": "error",
        "jsx-a11y/no-access-key": "error",
        "jsx-a11y/no-aria-hidden-on-focusable": "error",
        "jsx-a11y/no-distracting-elements": "error",
        "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
        "jsx-a11y/no-noninteractive-element-interactions": "error",
        "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
        "jsx-a11y/no-noninteractive-tabindex": "error",
        "jsx-a11y/no-redundant-roles": "error",
        "jsx-a11y/no-static-element-interactions": "error",
        "jsx-a11y/role-has-required-aria-props": "error",
        "jsx-a11y/role-supports-aria-props": "error",
        "jsx-a11y/scope": "error",
        "jsx-a11y/tabindex-no-positive": "error",
        // Opening a session focuses its composer on purpose.
        "jsx-a11y/no-autofocus": "off",
        // It asks for <output> in place of role="status", which is the live region a status
        // line needs.
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": ["apps/web/**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@base-ui/react",
                "message": "Import primitives from @mend/ui, which themes them to the design; never from Base UI directly."
              },
              {
                "name": "@tanstack/react-query",
                "importNames": ["QueryClient"],
                "allowTypeImports": true,
                "message": "One QueryClient: the router builds it in src/router.tsx. Read it with useQueryClient()."
              }
            ],
            "patterns": [
              {
                "group": ["@base-ui/react/*", "@radix-ui/*"],
                "message": "Import primitives from @mend/ui, which themes them to the design; never from Base UI or Radix directly."
              },
              {
                "regex": "(^|/)ui-old(/|$)",
                "message": "The web app never imports the old kit. Build what you need in @mend/ui."
              }
            ]
          }
        ]
      }
    },
    {
      // The router builds the app's one QueryClient, and tests build their own.
      "files": ["apps/web/src/router.tsx", "apps/web/**/*.test.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@base-ui/react",
                "message": "Import primitives from @mend/ui, which themes them to the design; never from Base UI directly."
              },
              {
                "name": "@mend/ui-old",
                "message": "The web app never imports the old kit. Build what you need in @mend/ui."
              }
            ],
            "patterns": [
              {
                "group": ["@base-ui/react/*", "@radix-ui/*"],
                "message": "Import primitives from @mend/ui, which themes them to the design; never from Base UI or Radix directly."
              },
              {
                "regex": "(^|/)ui-old(/|$)",
                "message": "The web app never imports the old kit. Build what you need in @mend/ui."
              }
            ]
          }
        ]
      }
    },
    {
      // shadcn's generated code meets three rules that are wrong for it (SLNT-1090): a code
      // block's lines and a line's tokens are positional lists that never reorder, so the index is
      // their identity; a scrollable code block takes keyboard focus so it can be scrolled without
      // a mouse (axe's scrollable-region-focusable); and an input group's addon only forwards a
      // click to its input, which keyboard users reach directly.
      "files": [
        "packages/ui/src/components/ui/code-block.tsx",
        "packages/ui/src/lib/highlighter.tsx"
      ],
      "plugins": ["react", "jsx-a11y"],
      "rules": { "react/no-array-index-key": "off", "jsx-a11y/no-noninteractive-tabindex": "off" }
    },
    {
      "files": ["packages/ui/src/components/ui/input-group.tsx"],
      "plugins": ["jsx-a11y"],
      "rules": {
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        // Naming the plugin here turns on its defaults; the kit's rules above leave this one off.
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      // A test builds a bare router around the one thing it renders.
      "files": ["apps/web/**/*.test.{ts,tsx}", "packages/ui/**/*.test.{ts,tsx}"],
      "rules": { "mend/router-default-states": "off" }
    },
    {
      "files": ["packages/ui/**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@mend/web",
                "message": "The kit imports nothing from an app."
              },
              {
                "name": "@mend/api-contracts",
                "message": "The kit knows nothing of Mend's data. Take what a component shows as props."
              },
              {
                "name": "@mend/domain",
                "message": "The kit knows nothing of Mend's data. Take what a component shows as props."
              }
            ],
            "patterns": [
              {
                "group": ["@mend/web/*", "@mend/api-contracts/*", "@mend/domain/*"],
                "message": "The kit imports nothing from an app, and knows nothing of Mend's data."
              },
              {
                "group": ["@trpc/*"],
                "message": "The kit knows nothing of Mend's data. Take what a component shows as props."
              },
              {
                "regex": "(^|/)(apps/|ui-old(/|$))",
                "message": "The kit imports nothing from an app or the old kit."
              }
            ]
          }
        ]
      }
    },
    {
      // Every span the server code names reads in Sentry by its entry in @mend/telemetry's span
      // catalog (SLNT-1407): `mend/span-name` says so where the span is named, since a package's
      // own tests don't rerun telemetry's. tooling/oxlint-plugin-mend/README.md says what it flags.
      "files": ["apps/*/src/**/*.{ts,tsx}", "packages/*/src/**/*.{ts,tsx}"],
      "jsPlugins": [{ "name": "mend", "specifier": "./tooling/oxlint-plugin-mend/src/index.ts" }],
      "rules": { "mend/span-name": "error" }
    }
  ]
}
