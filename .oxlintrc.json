{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "promise", "node", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    ".turbo/**",
    ".direnv/**",
    // t3code's contracts, copied verbatim at a pinned tag and never edited (ADR 0012).
    "packages/t3-contracts/src/**",
    "packages/t3-contracts/shared/**"
  ],
  "rules": {
    "import/no-cycle": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "unicorn/prefer-node-protocol": "error",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_splat", "_tag", "_values"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/sessions/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@effect/vitest",
                "message": "Use test/effect-vitest.ts so captured TestClock warnings fail the runner; ordinary assertions and hooks come from vitest."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/sessions/test/effect-vitest.ts"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": ["packages/ui/src/components/ui/**"],
      "rules": {
        "no-shadow": "off"
      }
    },
    {
      "files": ["apps/desktop/src/renderer/src/terminal/ghostty/**"],
      "rules": {
        "unicorn/consistent-function-scoping": "off",
        "no-underscore-dangle": "off",
        "promise/always-return": "off",
        "promise/no-nesting": "off",
        "import/no-cycle": "off"
      }
    }
  ]
}
