{
  "name": "@mend/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "The Mend desktop app: Electron shell around the Mend web workbench",
  "homepage": "https://github.com/sealant-sh/Mend",
  "license": "Apache-2.0",
  "author": "Sealant",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "check:connection": "node scripts/check-connection.mjs",
    "dev": "electron-vite dev",
    "lint": "OXLINT_TSGOLINT_PATH=../../node_modules/.bin/tsrs-lint oxlint --type-aware .",
    "package": "electron-vite build && electron-builder --config electron-builder.config.ts",
    "preview": "electron-vite preview",
    "sentry:upload": "node scripts/upload-sourcemaps.ts",
    "start": "electron-vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsrs -p tsconfig.json --noEmit --checkers 1 && tsrs -p tsconfig.node.json --noEmit --checkers 1"
  },
  "devDependencies": {
    "@mend/client-errors": "workspace:*",
    "@mend/test-ci": "workspace:*",
    "@mend/typescript": "workspace:*",
    "@mend/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "lucide-react": "catalog:",
    "playwright-core": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
