{
  "name": "@mend/t3-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "A t3code environment in front of Mend: t3code's clients pair with it and see Mend (ADR 0012)",
  "bin": {
    "mend-t3-gateway": "./src/bin.ts"
  },
  "type": "module",
  "scripts": {
    "build": "BUNDLE_ENTRIES=src/bin.ts,src/find-parse-worker.ts BUNDLE_EXTERNAL=bufferutil,utf-8-validate node ../../tooling/scripts/bundle-app.mjs",
    "lint": "oxlint .",
    "start": "node src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@mend/agent-conversation": "workspace:*",
    "@mend/domain": "workspace:*",
    "@mend/network": "workspace:*",
    "@mend/t3-contracts": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@mend/agent-protocol": "workspace:*",
    "@mend/test-ci": "workspace:*",
    "@mend/typescript": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
