{
  "name": "mend",
  "displayName": "Mend by Sealant",
  "version": "0.36.1",
  "private": true,
  "description": "Open and steer Mend coding-agent sessions from VS Code.",
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "agents",
    "claude",
    "codex",
    "coding-agent",
    "mend",
    "remote-ssh",
    "review",
    "sessions",
    "worktrees"
  ],
  "homepage": "https://docs.mend.run/clients/vscode/",
  "bugs": {
    "url": "https://github.com/sealant-sh/Mend/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sealant-sh/Mend.git",
    "directory": "apps/vscode"
  },
  "qna": false,
  "publisher": "sealant-sh",
  "files": [
    "dist/extension.js",
    "resources",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsgo -p tsconfig.json --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "package": "vsce package --no-dependencies",
    "test": "vitest run",
    "test:e2e": "node ../../scripts/vscode-remote-acceptance.mjs",
    "typecheck": "tsgo -p tsconfig.json --noEmit && tsgo -p test/e2e/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mend/domain": "workspace:*",
    "@mend/workspace-ssh": "workspace:*"
  },
  "devDependencies": {
    "@mend/test-ci": "workspace:*",
    "@mend/typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "catalog:",
    "ovsx": "^1.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mend",
          "title": "Mend",
          "icon": "resources/mend.svg"
        }
      ]
    },
    "views": {
      "mend": [
        {
          "id": "mend.sessions",
          "name": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mend.sessions",
        "contents": "Connect VS Code to your Mend server.\n[Connect](command:mend.connect)",
        "when": "mend.welcome == connect"
      },
      {
        "view": "mend.sessions",
        "contents": "Open sessions in VS Code: needs Remote-SSH and an SSH key for Mend\n[Set up](command:mend.setupWorkspaceSsh)\nEverything but Open works without it. [Skip for now](command:mend.skipWorkspaceSsh)",
        "when": "mend.welcome == setUp"
      },
      {
        "view": "mend.sessions",
        "contents": "Nothing adopted yet.\n[Adopt a repository…](command:mend.adoptProject)",
        "when": "mend.welcome == adoptRepository"
      }
    ],
    "authentication": [
      {
        "id": "mend",
        "label": "Mend"
      }
    ],
    "commands": [
      {
        "command": "mend.refresh",
        "title": "Mend: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mend.connect",
        "title": "Mend: Connect to server"
      },
      {
        "command": "mend.useCli",
        "title": "Mend: Use the Mend CLI's sign-in"
      },
      {
        "command": "mend.signOut",
        "title": "Mend: Sign out"
      },
      {
        "command": "mend.skipWorkspaceSsh",
        "title": "Mend: Skip workspace SSH setup for now"
      },
      {
        "command": "mend.adoptHere",
        "title": "Mend: Adopt this repository"
      },
      {
        "command": "mend.adoptProject",
        "title": "Mend: Adopt a repository…",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mend.open",
        "title": "Mend: Open",
        "icon": "$(window)"
      },
      {
        "command": "mend.openInNewWindow",
        "title": "Mend: Open in New Window"
      },
      {
        "command": "mend.answer",
        "title": "Mend: Answer",
        "icon": "$(comment-discussion)",
        "enablement": "!mend.offline"
      },
      {
        "command": "mend.pickSession",
        "title": "Mend: Choose a session"
      },
      {
        "command": "mend.openTerminal",
        "title": "Mend: Open terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "mend.watchTerminal",
        "title": "Mend: Watch terminal",
        "icon": "$(eye)"
      },
      {
        "command": "mend.reviewChange",
        "title": "Mend: Review change",
        "icon": "$(diff)"
      },
      {
        "command": "mend.newSessionInWorktree",
        "title": "Mend: New session in this worktree…",
        "icon": "$(add)"
      },
      {
        "command": "mend.openInMend",
        "title": "Mend: Open in Mend",
        "icon": "$(link-external)"
      },
      {
        "command": "mend.copyWorktreePath",
        "title": "Mend: Copy worktree path"
      },
      {
        "command": "mend.setupWorkspaceSsh",
        "title": "Mend: Set up workspace SSH"
      },
      {
        "command": "mend.stopSession",
        "title": "Mend: Stop session",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mend.newSession",
        "title": "Mend: New session",
        "icon": "$(add)",
        "enablement": "!mend.offline"
      },
      {
        "command": "mend.newSessionOffline",
        "title": "Mend is offline · retrying",
        "icon": "$(add)",
        "enablement": "false"
      },
      {
        "command": "mend.showQuickPick",
        "title": "Mend: Show project sessions"
      },
      {
        "command": "mend.bringMyEditor",
        "title": "Mend: Bring my editor into this workspace"
      },
      {
        "command": "mend.showWorkspaceEditorLog",
        "title": "Mend: Show workspace editor log"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mend.newSessionOffline",
          "when": "false"
        },
        {
          "command": "mend.useCli",
          "when": "mend.welcome == useCli"
        },
        {
          "command": "mend.skipWorkspaceSsh",
          "when": "mend.welcome == setUp"
        },
        {
          "command": "mend.adoptHere",
          "when": "mend.welcome == adopt"
        }
      ],
      "view/title": [
        {
          "command": "mend.newSession",
          "when": "view == mend.sessions && !mend.offline",
          "group": "navigation@1"
        },
        {
          "command": "mend.newSessionOffline",
          "when": "view == mend.sessions && mend.offline",
          "group": "navigation@1"
        },
        {
          "command": "mend.refresh",
          "when": "view == mend.sessions",
          "group": "navigation"
        },
        {
          "command": "mend.adoptProject",
          "when": "view == mend.sessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "mend.answer",
          "when": "view == mend.sessions && viewItem =~ /\\.needs$/",
          "group": "inline@0"
        },
        {
          "command": "mend.answer",
          "when": "view == mend.sessions && viewItem =~ /\\.needs$/",
          "group": "0_answer@0"
        },
        {
          "command": "mend.newSession",
          "when": "view == mend.sessions && viewItem == mend.project",
          "group": "inline@1"
        },
        {
          "command": "mend.newSession",
          "when": "view == mend.sessions && viewItem == mend.project",
          "group": "navigation@1"
        },
        {
          "command": "mend.open",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.(live|settled)\\.open(\\.steer)?(\\.needs)?$/",
          "group": "inline@1"
        },
        {
          "command": "mend.watchTerminal",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.live\\.watch\\.steer(\\.needs)?$/",
          "group": "inline@1"
        },
        {
          "command": "mend.reviewChange",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.(live|settled)\\.(review|watch)(\\.steer)?(\\.needs)?$/",
          "group": "inline@2"
        },
        {
          "command": "mend.openInMend",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session/",
          "group": "inline@3"
        },
        {
          "command": "mend.open",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.(live|settled)\\.open(\\.steer)?(\\.needs)?$/",
          "group": "1_open@0"
        },
        {
          "command": "mend.openInNewWindow",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.(live|settled)\\.open(\\.steer)?(\\.needs)?$/",
          "group": "1_open@1"
        },
        {
          "command": "mend.openTerminal",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.live\\.open\\.steer(\\.needs)?$/",
          "group": "1_open@2"
        },
        {
          "command": "mend.watchTerminal",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.live\\.watch\\.steer(\\.needs)?$/",
          "group": "1_open@2"
        },
        {
          "command": "mend.newSessionInWorktree",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.(live|settled)\\.open(\\.steer)?(\\.needs)?$/",
          "group": "1_open@3"
        },
        {
          "command": "mend.reviewChange",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session/",
          "group": "1_open@4"
        },
        {
          "command": "mend.stopSession",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.live\\.[a-z]+\\.steer(\\.needs)?$/",
          "group": "2_session@1"
        },
        {
          "command": "mend.copyWorktreePath",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session/",
          "group": "2_session@2"
        }
      ]
    },
    "configuration": {
      "title": "Mend",
      "properties": {
        "mend.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Mend server URL. Empty uses the Mend CLI configuration, then http://localhost:3105."
        },
        "mend.workspaceSshHost": {
          "type": "string",
          "default": "",
          "description": "Optional SSH hostname override for the configured Mend server. Leave empty to use the hostname from mend.serverUrl. The server still supplies the published SSH port."
        },
        "mend.workspaces.bringMyEditor": {
          "type": "string",
          "enum": [
            "off",
            "extensions",
            "extensionsAndSettings"
          ],
          "enumDescriptions": [
            "Leave Mend workspaces as VS Code makes them.",
            "Install your local extensions that run in a workspace into each Mend workspace you open.",
            "Extensions, and your remote machine settings. Machine settings are not in this build yet, so this behaves like extensions."
          ],
          "default": "extensionsAndSettings",
          "scope": "application",
          "description": "Bring your editor into Mend workspaces: when a Mend workspace window opens in your own home, Mend installs the extensions from your local VS Code that run in a workspace, in the background. Machine settings are not in this build yet. Shared and root homes get nothing."
        }
      }
    },
    "colors": [
      {
        "id": "mend.status.waiting",
        "description": "A session that waits for a person: the amber dot of DESIGN.md.",
        "defaults": {
          "light": "#cf9a18",
          "dark": "#cf9a18",
          "highContrast": "#cf9a18",
          "highContrastLight": "#9a6700"
        }
      },
      {
        "id": "mend.status.running",
        "description": "A session that is starting or running: the cobalt dot of DESIGN.md.",
        "defaults": {
          "light": "#2052cc",
          "dark": "#5781ea",
          "highContrast": "#5781ea",
          "highContrastLight": "#2052cc"
        }
      },
      {
        "id": "mend.status.observed",
        "description": "A session that completed or landed, as observed: the green dot of DESIGN.md.",
        "defaults": {
          "light": "#5f9e77",
          "dark": "#5f9e77",
          "highContrast": "#5f9e77",
          "highContrastLight": "#2e7d46"
        }
      },
      {
        "id": "mend.status.failed",
        "description": "A session that failed, as observed: the red dot of DESIGN.md.",
        "defaults": {
          "light": "#c0362c",
          "dark": "#c0362c",
          "highContrast": "#c0362c",
          "highContrastLight": "#b3261e"
        }
      },
      {
        "id": "mend.status.settled",
        "description": "A session that stopped: the hollow ring of DESIGN.md.",
        "defaults": {
          "light": "#b3b0a8",
          "dark": "#b3b0a8",
          "highContrast": "#b3b0a8",
          "highContrastLight": "#5b5b62"
        }
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#faf9f7",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "pricing": "Free"
}
