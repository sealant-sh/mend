{
  "name": "mend",
  "displayName": "Mend by Sealant",
  "version": "0.36.3",
  "private": true,
  "description": "Open and steer Mend coding-agent sessions from VS Code.",
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "agents",
    "claude",
    "codex",
    "coding-agent",
    "mend",
    "remote-ssh",
    "review",
    "sessions",
    "worktrees"
  ],
  "homepage": "https://docs.mend.run/clients/vscode/",
  "bugs": {
    "url": "https://github.com/sealant-sh/Mend/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sealant-sh/Mend.git",
    "directory": "apps/vscode"
  },
  "qna": false,
  "publisher": "sealant-sh",
  "files": [
    "dist/extension.js",
    "dist/handoff-worker.js",
    "resources",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "package": "vsce package --no-dependencies",
    "test": "vitest run",
    "test:e2e": "node ../../scripts/vscode-remote-acceptance.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/e2e/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mend/agent-conversation": "workspace:*",
    "@mend/domain": "workspace:*",
    "@mend/local-git": "workspace:*",
    "@mend/workspace-ssh": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@mend/test-ci": "workspace:*",
    "@mend/typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "catalog:",
    "ovsx": "^1.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mend",
          "title": "Mend",
          "icon": "resources/mend.svg"
        }
      ]
    },
    "views": {
      "mend": [
        {
          "id": "mend.sessions",
          "name": "Sessions"
        },
        {
          "id": "mend.change",
          "name": "Change",
          "when": "mend.welcome == none"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mend.sessions",
        "contents": "Connect VS Code to your Mend server.\n[Connect](command:mend.connect)",
        "when": "mend.welcome == connect"
      },
      {
        "view": "mend.sessions",
        "contents": "Open sessions in VS Code: needs Remote-SSH and an SSH key for Mend\n[Set up](command:mend.setupWorkspaceSsh)\nEverything but Open works without it. [Skip for now](command:mend.skipWorkspaceSsh)",
        "when": "mend.welcome == setUp"
      },
      {
        "view": "mend.sessions",
        "contents": "Nothing adopted yet.\n[Adopt a repository…](command:mend.adoptProject)",
        "when": "mend.welcome == adoptRepository"
      }
    ],
    "authentication": [
      {
        "id": "mend",
        "label": "Mend"
      }
    ],
    "commands": [
      {
        "command": "mend.refresh",
        "title": "Mend: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mend.connect",
        "title": "Mend: Connect to server"
      },
      {
        "command": "mend.useCli",
        "title": "Mend: Use the Mend CLI's sign-in"
      },
      {
        "command": "mend.signOut",
        "title": "Mend: Sign out"
      },
      {
        "command": "mend.skipWorkspaceSsh",
        "title": "Mend: Skip workspace SSH setup for now"
      },
      {
        "command": "mend.adoptHere",
        "title": "Mend: Adopt this repository"
      },
      {
        "command": "mend.setupSession",
        "title": "Mend: Set up this project"
      },
      {
        "command": "mend.adoptProject",
        "title": "Mend: Adopt a repository…",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mend.open",
        "title": "Mend: Open",
        "icon": "$(window)"
      },
      {
        "command": "mend.openInNewWindow",
        "title": "Mend: Open in New Window"
      },
      {
        "command": "mend.answer",
        "title": "Mend: Answer",
        "icon": "$(comment-discussion)",
        "enablement": "!mend.offline"
      },
      {
        "command": "mend.answerOffline",
        "title": "Mend is offline",
        "icon": "$(comment-discussion)",
        "enablement": "false"
      },
      {
        "command": "mend.pickSession",
        "title": "Mend: Choose a session"
      },
      {
        "command": "mend.openTerminal",
        "title": "Mend: Open terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "mend.watchTerminal",
        "title": "Mend: Watch terminal",
        "icon": "$(eye)"
      },
      {
        "command": "mend.reviewChange",
        "title": "Mend: Review change",
        "icon": "$(diff)"
      },
      {
        "command": "mend.newSessionInWorktree",
        "title": "Mend: New session in this worktree…",
        "icon": "$(add)"
      },
      {
        "command": "mend.openInMend",
        "title": "Mend: Open in Mend",
        "icon": "$(link-external)"
      },
      {
        "command": "mend.copyWorktreePath",
        "title": "Mend: Copy worktree path"
      },
      {
        "command": "mend.setupWorkspaceSsh",
        "title": "Mend: Set up workspace SSH"
      },
      {
        "command": "mend.stopSession",
        "title": "Mend: Stop session",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mend.newSession",
        "title": "Mend: New session",
        "icon": "$(add)",
        "enablement": "!mend.offline"
      },
      {
        "command": "mend.newSessionOffline",
        "title": "Mend is offline · retrying",
        "icon": "$(add)",
        "enablement": "false"
      },
      {
        "command": "mend.showQuickPick",
        "title": "Mend: Show project sessions"
      },
      {
        "command": "mend.bringMyEditor",
        "title": "Mend: Bring my editor into this workspace"
      },
      {
        "command": "mend.showWorkspaceEditorLog",
        "title": "Mend: Show workspace editor log"
      },
      {
        "command": "mend.change.openAll",
        "title": "Open all changes",
        "category": "Mend",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "mend.change.pickSlice",
        "title": "Choose what to review",
        "category": "Mend"
      },
      {
        "command": "mend.change.openInWeb",
        "title": "Open in Mend (web)",
        "category": "Mend"
      },
      {
        "command": "mend.change.refresh",
        "title": "Read the change again",
        "category": "Mend"
      },
      {
        "command": "mend.change.openFile",
        "title": "Open the file's diff",
        "category": "Mend"
      },
      {
        "command": "mend.change.repin",
        "title": "Review the newer change",
        "category": "Mend"
      },
      {
        "command": "mend.change.readNewer",
        "title": "Read the newer slice",
        "category": "Mend"
      },
      {
        "command": "mend.change.read",
        "title": "Read this change",
        "category": "Mend",
        "icon": "$(sparkle)",
        "enablement": "!mend.offline"
      },
      {
        "command": "mend.change.showRecord",
        "title": "Show record",
        "category": "Mend"
      },
      {
        "command": "mend.change.openComment",
        "title": "Show the comment",
        "category": "Mend"
      },
      {
        "command": "mend.review.addComment",
        "title": "Add comment",
        "category": "Mend"
      },
      {
        "command": "mend.review.accept",
        "title": "Accept",
        "category": "Mend"
      },
      {
        "command": "mend.review.dismiss",
        "title": "Dismiss",
        "category": "Mend"
      },
      {
        "command": "mend.review.edit",
        "title": "Edit",
        "category": "Mend",
        "icon": "$(edit)"
      },
      {
        "command": "mend.review.delete",
        "title": "Delete",
        "category": "Mend",
        "icon": "$(trash)"
      },
      {
        "command": "mend.review.save",
        "title": "Save",
        "category": "Mend"
      },
      {
        "command": "mend.review.cancel",
        "title": "Cancel",
        "category": "Mend"
      },
      {
        "command": "mend.change.sendReview",
        "title": "Send review",
        "category": "Mend"
      },
      {
        "command": "mend.change.retryDelivery",
        "title": "Retry delivery",
        "category": "Mend"
      },
      {
        "command": "mend.change.sendReviewOffline",
        "title": "Mend is offline; your comments are kept",
        "icon": "$(comment-discussion)",
        "enablement": "false"
      },
      {
        "command": "mend.change.sendReviewNotHers",
        "title": "Only the session's owner sends it a review: Mend types it into a terminal agent, live or started for the stopped session",
        "icon": "$(comment-discussion)",
        "enablement": "false"
      },
      {
        "command": "mend.change.sendToSession",
        "title": "Send to session",
        "category": "Mend"
      },
      {
        "command": "mend.change.repin",
        "title": "Review the newer change",
        "category": "Mend"
      },
      {
        "command": "mend.review.addressed",
        "title": "Addressed",
        "category": "Mend",
        "icon": "$(check)"
      },
      {
        "command": "mend.review.reopen",
        "title": "Reopen",
        "category": "Mend",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "mend.review.retry",
        "title": "Retry delivery",
        "category": "Mend",
        "icon": "$(sync)"
      },
      {
        "command": "mend.handoffBranch",
        "title": "Hand off to Mend…",
        "category": "Mend",
        "icon": "$(cloud-upload)",
        "enablement": "mend.handoff.localGit && mend.handoff.support == supported && !mend.offline"
      },
      {
        "command": "mend.handoffOffline",
        "title": "Mend is offline · retrying",
        "icon": "$(cloud-upload)",
        "enablement": "false"
      },
      {
        "command": "mend.handoffUnsupported",
        "title": "This Mend server doesn't take handoffs yet · added in Mend 0.36",
        "icon": "$(cloud-upload)",
        "enablement": "false"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mend.newSessionOffline",
          "when": "false"
        },
        {
          "command": "mend.answerOffline",
          "when": "false"
        },
        {
          "command": "mend.useCli",
          "when": "mend.welcome == useCli"
        },
        {
          "command": "mend.skipWorkspaceSsh",
          "when": "mend.welcome == setUp"
        },
        {
          "command": "mend.adoptHere",
          "when": "mend.welcome == adopt"
        },
        {
          "command": "mend.change.openFile",
          "when": "false"
        },
        {
          "command": "mend.change.openAll",
          "when": "mend.change.files"
        },
        {
          "command": "mend.change.pickSlice",
          "when": "mend.change.ready"
        },
        {
          "command": "mend.change.openInWeb",
          "when": "false"
        },
        {
          "command": "mend.change.repin",
          "when": "mend.change.ready"
        },
        {
          "command": "mend.change.readNewer",
          "when": "false"
        },
        {
          "command": "mend.change.read",
          "when": "mend.change.ready"
        },
        {
          "command": "mend.change.showRecord",
          "when": "mend.change.ready"
        },
        {
          "command": "mend.change.openComment",
          "when": "false"
        },
        {
          "command": "mend.review.addComment",
          "when": "false"
        },
        {
          "command": "mend.review.accept",
          "when": "false"
        },
        {
          "command": "mend.review.dismiss",
          "when": "false"
        },
        {
          "command": "mend.review.edit",
          "when": "false"
        },
        {
          "command": "mend.review.delete",
          "when": "false"
        },
        {
          "command": "mend.review.save",
          "when": "false"
        },
        {
          "command": "mend.review.cancel",
          "when": "false"
        },
        {
          "command": "mend.change.sendReview",
          "when": "mend.change.send == ready"
        },
        {
          "command": "mend.change.retryDelivery",
          "when": "mend.change.send == retry"
        },
        {
          "command": "mend.change.sendReviewOffline",
          "when": "false"
        },
        {
          "command": "mend.change.sendReviewNotHers",
          "when": "false"
        },
        {
          "command": "mend.change.sendToSession",
          "when": "resourceScheme == mend-review"
        },
        {
          "command": "mend.change.repin",
          "when": "mend.change.ready"
        },
        {
          "command": "mend.review.addressed",
          "when": "false"
        },
        {
          "command": "mend.review.reopen",
          "when": "false"
        },
        {
          "command": "mend.review.retry",
          "when": "false"
        },
        {
          "command": "mend.handoffBranch",
          "when": "mend.handoff.localGit && mend.handoff.support == supported && !mend.offline"
        },
        {
          "command": "mend.handoffOffline",
          "when": "false"
        },
        {
          "command": "mend.handoffUnsupported",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "mend.newSession",
          "when": "view == mend.sessions && !mend.offline",
          "group": "navigation@1"
        },
        {
          "command": "mend.newSessionOffline",
          "when": "view == mend.sessions && mend.offline",
          "group": "navigation@1"
        },
        {
          "command": "mend.refresh",
          "when": "view == mend.sessions",
          "group": "navigation"
        },
        {
          "command": "mend.adoptProject",
          "when": "view == mend.sessions",
          "group": "navigation"
        },
        {
          "command": "mend.change.openAll",
          "when": "view == mend.change && mend.change.files",
          "group": "navigation@2"
        },
        {
          "command": "mend.change.openInWeb",
          "when": "view == mend.change && mend.change.ready",
          "group": "overflow@1"
        },
        {
          "command": "mend.change.refresh",
          "when": "view == mend.change",
          "group": "overflow@2"
        },
        {
          "command": "mend.change.read",
          "when": "view == mend.change && mend.change.ready",
          "group": "navigation@1"
        },
        {
          "command": "mend.change.showRecord",
          "when": "view == mend.change && mend.change.ready",
          "group": "overflow@3"
        },
        {
          "command": "mend.change.sendReview",
          "when": "view == mend.change && mend.change.send == ready",
          "group": "navigation@3"
        },
        {
          "command": "mend.change.retryDelivery",
          "when": "view == mend.change && mend.change.send == retry",
          "group": "navigation@3"
        },
        {
          "command": "mend.change.sendReviewOffline",
          "when": "view == mend.change && mend.change.send == offline",
          "group": "navigation@3"
        },
        {
          "command": "mend.change.sendReviewNotHers",
          "when": "view == mend.change && mend.change.send == notHers",
          "group": "navigation@3"
        },
        {
          "command": "mend.handoffBranch",
          "when": "view == mend.sessions && mend.handoff.localGit && mend.handoff.support == supported && !mend.offline",
          "group": "navigation@2"
        },
        {
          "command": "mend.handoffOffline",
          "when": "view == mend.sessions && mend.handoff.localGit && mend.offline",
          "group": "navigation@2"
        },
        {
          "command": "mend.handoffUnsupported",
          "when": "view == mend.sessions && mend.handoff.localGit && !mend.offline && mend.handoff.support == unsupported",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "mend.answer",
          "when": "view == mend.sessions && viewItem =~ /\\.needs$/ && !mend.offline",
          "group": "inline@0"
        },
        {
          "command": "mend.answerOffline",
          "when": "view == mend.sessions && viewItem =~ /\\.needs$/ && mend.offline",
          "group": "inline@0"
        },
        {
          "command": "mend.answer",
          "when": "view == mend.sessions && viewItem =~ /\\.needs$/",
          "group": "0_answer@0"
        },
        {
          "command": "mend.newSession",
          "when": "view == mend.sessions && viewItem == mend.project",
          "group": "inline@1"
        },
        {
          "command": "mend.newSession",
          "when": "view == mend.sessions && viewItem == mend.project",
          "group": "navigation@1"
        },
        {
          "command": "mend.open",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.(live|settled)\\.open(\\.steer)?(\\.needs)?$/",
          "group": "inline@1"
        },
        {
          "command": "mend.watchTerminal",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.live\\.watch\\.steer(\\.needs)?$/",
          "group": "inline@1"
        },
        {
          "command": "mend.reviewChange",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.(live|settled)\\.(review|watch)(\\.steer)?(\\.needs)?$/",
          "group": "inline@2"
        },
        {
          "command": "mend.openInMend",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session/",
          "group": "3_web@1"
        },
        {
          "command": "mend.open",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.(live|settled)\\.open(\\.steer)?(\\.needs)?$/",
          "group": "1_open@0"
        },
        {
          "command": "mend.openInNewWindow",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.(live|settled)\\.open(\\.steer)?(\\.needs)?$/",
          "group": "1_open@1"
        },
        {
          "command": "mend.openTerminal",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.live\\.open\\.steer(\\.needs)?$/",
          "group": "1_open@2"
        },
        {
          "command": "mend.watchTerminal",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.live\\.watch\\.steer(\\.needs)?$/",
          "group": "1_open@2"
        },
        {
          "command": "mend.newSessionInWorktree",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.(live|settled)\\.open(\\.steer)?(\\.needs)?$/",
          "group": "1_open@3"
        },
        {
          "command": "mend.reviewChange",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session/",
          "group": "1_open@4"
        },
        {
          "command": "mend.stopSession",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session\\.live\\.[a-z]+\\.steer(\\.needs)?$/",
          "group": "2_session@1"
        },
        {
          "command": "mend.copyWorktreePath",
          "when": "view == mend.sessions && viewItem =~ /^mend\\.session/",
          "group": "2_session@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "mend.review.addComment",
          "group": "inline@1",
          "when": "commentController =~ /^mend\\.review(\\.note)?$/ && commentThreadIsEmpty"
        },
        {
          "command": "mend.review.accept",
          "group": "inline@1",
          "when": "commentController =~ /^mend\\.review(\\.note)?$/ && commentThread == mend.thread.draft"
        },
        {
          "command": "mend.review.dismiss",
          "group": "inline@2",
          "when": "commentController =~ /^mend\\.review(\\.note)?$/ && commentThread == mend.thread.draft"
        }
      ],
      "comments/comment/title": [
        {
          "command": "mend.review.edit",
          "group": "inline@1",
          "when": "commentController =~ /^mend\\.review(\\.note)?$/ && comment =~ /^mend\\.comment\\.(pending|accepted)$/"
        },
        {
          "command": "mend.review.delete",
          "group": "inline@2",
          "when": "commentController =~ /^mend\\.review(\\.note)?$/ && comment =~ /^mend\\.comment\\.(pending|accepted)$/"
        },
        {
          "command": "mend.review.addressed",
          "group": "inline@1",
          "when": "commentController =~ /^mend\\.review(\\.note)?$/ && comment =~ /^mend\\.comment\\.(sent|waiting|held)$/"
        },
        {
          "command": "mend.review.reopen",
          "group": "inline@1",
          "when": "commentController =~ /^mend\\.review(\\.note)?$/ && comment == mend.comment.addressed"
        },
        {
          "command": "mend.review.retry",
          "group": "inline@1",
          "when": "commentController =~ /^mend\\.review(\\.note)?$/ && comment =~ /^mend\\.comment\\.(failed|held)$/"
        }
      ],
      "comments/comment/context": [
        {
          "command": "mend.review.save",
          "group": "inline@1",
          "when": "commentController =~ /^mend\\.review(\\.note)?$/ && comment =~ /^mend\\.comment\\.(pending|accepted)$/"
        },
        {
          "command": "mend.review.cancel",
          "group": "inline@2",
          "when": "commentController =~ /^mend\\.review(\\.note)?$/ && comment =~ /^mend\\.comment\\.(pending|accepted)$/"
        }
      ],
      "editor/title": [
        {
          "command": "mend.change.sendToSession",
          "when": "resourceScheme == mend-review",
          "group": "navigation@1"
        }
      ],
      "scm/title": [
        {
          "command": "mend.handoffBranch",
          "when": "scmProvider == git && mend.handoff.localGit && mend.handoff.support == supported && !mend.offline",
          "group": "mend@1"
        },
        {
          "command": "mend.handoffOffline",
          "when": "scmProvider == git && mend.handoff.localGit && mend.offline",
          "group": "mend@1"
        },
        {
          "command": "mend.handoffUnsupported",
          "when": "scmProvider == git && mend.handoff.localGit && !mend.offline && mend.handoff.support == unsupported",
          "group": "mend@1"
        }
      ]
    },
    "configuration": {
      "title": "Mend",
      "properties": {
        "mend.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Mend server URL. Empty uses the Mend CLI configuration, then http://localhost:3105."
        },
        "mend.workspaceSshHost": {
          "type": "string",
          "default": "",
          "description": "Optional SSH hostname override for the configured Mend server. Leave empty to use the hostname from mend.serverUrl. The server still supplies the published SSH port."
        },
        "mend.workspaces.bringMyEditor": {
          "type": "string",
          "enum": [
            "off",
            "picked"
          ],
          "enumDescriptions": [
            "Leave Mend workspaces as VS Code makes them.",
            "Carry the extensions you install in a project's Mend workspace window to that project's later sessions."
          ],
          "default": "picked",
          "scope": "application",
          "description": "Bring your editor into Mend workspaces: the extensions you install from the Extensions panel in a project's Mend workspace window are installed again, in the background, in that project's later sessions. Uninstalling one there stops it. Your settings already apply through VS Code. Shared and root homes get nothing."
        }
      }
    },
    "colors": [
      {
        "id": "mend.status.waiting",
        "description": "A session that waits for a person: the amber dot of DESIGN.md.",
        "defaults": {
          "light": "#cf9a18",
          "dark": "#cf9a18",
          "highContrast": "#cf9a18",
          "highContrastLight": "#9a6700"
        }
      },
      {
        "id": "mend.status.running",
        "description": "A session that is starting or running: the cobalt dot of DESIGN.md.",
        "defaults": {
          "light": "#2052cc",
          "dark": "#5781ea",
          "highContrast": "#5781ea",
          "highContrastLight": "#2052cc"
        }
      },
      {
        "id": "mend.status.observed",
        "description": "A session that completed or landed, as observed: the green dot of DESIGN.md.",
        "defaults": {
          "light": "#5f9e77",
          "dark": "#5f9e77",
          "highContrast": "#5f9e77",
          "highContrastLight": "#2e7d46"
        }
      },
      {
        "id": "mend.status.failed",
        "description": "A session that failed, as observed: the red dot of DESIGN.md.",
        "defaults": {
          "light": "#c0362c",
          "dark": "#c0362c",
          "highContrast": "#c0362c",
          "highContrastLight": "#b3261e"
        }
      },
      {
        "id": "mend.status.settled",
        "description": "A session that stopped: the hollow ring of DESIGN.md.",
        "defaults": {
          "light": "#b3b0a8",
          "dark": "#b3b0a8",
          "highContrast": "#b3b0a8",
          "highContrastLight": "#5b5b62"
        }
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#faf9f7",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "pricing": "Free"
}
