{
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck", "build"]
    },
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!public/install.sh",
        ".env*",
        "$TURBO_ROOT$/tooling/scripts/**",
        "$TURBO_ROOT$/install.sh"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/deploy/**",
        "$TURBO_ROOT$/.claude/skills/verify/**",
        "$TURBO_ROOT$/install.sh"
      ]
    }
  }
}
