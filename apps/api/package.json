{
  "name": "@mend/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench:worktree-reads": "vitest run --config vitest.performance.config.ts",
    "build": "BUNDLE_ENTRIES=src/main.ts,src/page-check-worker.ts,src/screen-worker.ts BUNDLE_EXTERNAL=bufferutil,utf-8-validate,pg-native,@opentelemetry/api BUNDLE_ASSETS=../../packages/sessions/src/shell-profile node ../../tooling/scripts/bundle-app.mjs",
    "dev": "tsx watch src/main.ts",
    "lint": "oxlint .",
    "start": "node --experimental-strip-types src/main.ts",
    "test": "vitest run --passWithNoTests",
    "test:preview-acceptance": "vitest run --config vitest.preview.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@mend/api-contracts": "workspace:*",
    "@mend/auth": "workspace:*",
    "@mend/db": "workspace:*",
    "@mend/domain": "workspace:*",
    "@mend/inference": "workspace:*",
    "@mend/jobs": "workspace:*",
    "@mend/landing": "workspace:*",
    "@mend/network": "workspace:*",
    "@mend/sealant": "workspace:*",
    "@mend/sessions": "workspace:*",
    "@mend/slack": "workspace:*",
    "@mend/store": "workspace:*",
    "@mend/t3-contracts": "workspace:*",
    "@mend/ui": "workspace:*",
    "effect": "catalog:",
    "mediabunny": "catalog:",
    "werift": "^0.25.2"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@mend/test-ci": "workspace:*",
    "@mend/typescript": "workspace:*",
    "@sealant/sdk": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "esbuild": "catalog:",
    "fast-check": "catalog:",
    "jsdom": "catalog:",
    "playwright-core": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:start",
    "vitest": "catalog:",
    "ws": "catalog:"
  }
}
