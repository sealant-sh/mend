{
  "name": "@mend/web",
  "private": true,
  "description": "The Mend product app: the queue, the brief, the run audit",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vite build && node scripts/build-server.mjs",
    "dev": "node scripts/dev.mjs",
    "lint": "oxlint .",
    "preview": "vite preview",
    "start": "node --experimental-strip-types src/entry/main.ts",
    "test": "vitest run --passWithNoTests && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=../../scripts/ci-node-reporter.mjs --test-reporter-destination=stderr --test-reporter=../../scripts/ci-test-report.mjs --test-reporter-destination=stdout scripts/test-lifecycle.integration.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@fontsource/inter": "catalog:",
    "@fontsource/jetbrains-mono": "catalog:",
    "@fontsource/space-grotesk": "catalog:",
    "@mend/api-contracts": "workspace:*",
    "@mend/domain": "workspace:*",
    "@mend/network": "workspace:*",
    "@mend/sealant": "workspace:*",
    "@mend/t3-contracts": "workspace:*",
    "@mend/ui": "workspace:*",
    "@novnc/novnc": "1.7.0",
    "@pierre/diffs": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-auth": "catalog:",
    "effect": "catalog:",
    "ghostty-web": "catalog:",
    "lucide-react": "catalog:",
    "nitro": "^3.0.260610-beta",
    "qrcode": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "superjson": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@mend/test-ci": "workspace:*",
    "@mend/typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/qrcode": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "esbuild": "catalog:",
    "fast-check": "catalog:",
    "jsdom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:start",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}
