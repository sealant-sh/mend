{
  "expo": {
    "name": "Mend",
    "slug": "mend",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "mend",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/b63192dc-2cf7-4d37-a14b-7341df1feef9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yiannisp.sealant.mend",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "8ELGG87AE9"
    },
    "android": {
      "package": "com.yiannisp.mend",
      "adaptiveIcon": {
        "backgroundColor": "#edeae4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#edeae4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#161618"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Mend uses the camera to read the pairing code your machine shows, and to take a photo when you attach one to a message.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mend attaches the photos you choose to a message you send to a session.",
          "cameraPermission": "Mend uses the camera to read the pairing code your machine shows, and to take a photo when you attach one to a message.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b63192dc-2cf7-4d37-a14b-7341df1feef9"
      }
    },
    "owner": "ypanagidis"
  }
}
