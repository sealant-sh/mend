{
  "name": "@mend/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "The Mend mobile app: steer sessions and review changes from your phone",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "dev": "expo start",
    "ios": "expo start --ios",
    "ios:clean": "expo prebuild --clean && expo run:ios --device --configuration Release",
    "ios:release": "expo run:ios --device --configuration Release",
    "lint": "oxlint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@legendapp/list": "3.3.3",
    "@mend/agent-conversation": "workspace:*",
    "@mend/domain": "workspace:*",
    "@mend/network": "workspace:*",
    "@mend/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@t3tools/mobile-terminal-native": "file:./modules/t3-terminal",
    "@tanstack/react-query": "catalog:",
    "effect": "catalog:",
    "expo": "~57.0.8",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.8",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.19",
    "lucide-react-native": "^1.26.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "^1.22.2",
    "react-native-nitro-markdown": "0.9.0",
    "react-native-nitro-modules": "0.36.4",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@mend/api-contracts": "workspace:*",
    "@types/react": "catalog:",
    "typescript": "~6.0.3",
    "vitest": "catalog:"
  }
}
