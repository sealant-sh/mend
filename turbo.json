{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "CI",
        "MEND_TEST_DATABASE_URL",
        "MEND_SKIP_POSTGRES_TESTS",
        "VITEST_MAX_THREADS",
        "VITEST_MAX_FORKS",
        "VITEST_MAX_WORKERS"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
