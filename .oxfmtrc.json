{
  "arrowParens": "always",
  "printWidth": 100,
  "semi": true,
  "tabWidth": 2,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/routeTree.gen.ts",
    ".turbo/**",
    ".direnv/**",
    "deploy/helm/**/templates/**",
    // Shipped into workspaces byte for byte (the default shell profile).
    "packages/sessions/src/shell-profile/**",
    // t3code's contracts and their pin, written byte for byte by the copy script (ADR 0012).
    "packages/t3-contracts/src/**",
    "packages/t3-contracts/shared/**",
    "packages/t3-contracts/t3code.pin.json"
  ],
  "sortImports": {
    "ignoreCase": true,
    "newlinesBetween": true,
    "order": "asc"
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "proseWrap": "always" // printWidth line breaks in MD/MDX
}
