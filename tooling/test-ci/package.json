{
  "name": "@mend/test-ci",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./vitest": "./src/vitest.ts",
    "./effect-vitest": "./src/effect-vitest.ts"
  },
  "scripts": {
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "test:integration": "node --experimental-strip-types --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=../../scripts/ci-node-reporter.mjs --test-reporter-destination=stderr --test-reporter=../../scripts/ci-test-report.mjs --test-reporter-destination=stdout test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@mend/typescript": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  }
}
