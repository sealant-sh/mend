{
  "name": "@mend/oxlint-plugin-mend",
  "version": "0.0.0",
  "private": true,
  "description": "Mend's own oxlint rules for the web app and its UI kit",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "OXLINT_TSGOLINT_PATH=../../node_modules/.bin/tsrs-lint oxlint --type-aware . --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "typecheck": "tsrs -p tsconfig.json --noEmit --checkers 1"
  },
  "devDependencies": {
    "@mend/test-ci": "workspace:*",
    "@mend/typescript": "workspace:*",
    "@oxlint/plugins": "1.76.0",
    "@types/node": "catalog:",
    "oxlint": "1.76.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
