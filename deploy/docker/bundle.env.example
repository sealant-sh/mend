# Copy to .env beside compose.v2.yaml. Replace every GENERATE value and chmod 600 .env.
# The setup command will generate these values; this file records its v1 hand-off contract.
MEND_VERSION=0.0.0
APP_URL=http://localhost:3105
MEND_ALLOWED_ORIGINS=[]
MEND_BIND_HOST=127.0.0.1
MEND_PORT=3105
MEND_SSH_PORT=2222
SEALANT_SSH_HOST=localhost

# Generate each password/secret as 32 random bytes encoded as lowercase hex.
MEND_POSTGRES_ADMIN_PASSWORD=GENERATE_64_HEX
MEND_DB_PASSWORD=GENERATE_64_HEX
SEALANT_DB_PASSWORD=GENERATE_64_HEX
BETTER_AUTH_SECRET=GENERATE_64_HEX
WORKSPACE_SSH_GATEWAY_TOKEN=GENERATE_64_HEX
SEALANT_SERVICE_KEY=GENERATE_WITH_PUBLIC_SEALANT_BOOTSTRAP
# Exactly 32 random bytes encoded as base64.
SEALANT_CREDENTIALS_KEY=GENERATE_32_BYTES_BASE64

# The capture store's Garage bucket. Setup derives these from the identity (setup-contract
# "derivedSecrets"); by hand, generate the three hex values as 32 random bytes and the key id as
# GK followed by 24 random hex characters.
MEND_GARAGE_RPC_SECRET=GENERATE_64_HEX
MEND_GARAGE_ADMIN_TOKEN=GENERATE_64_HEX
MEND_GARAGE_KEY_ID=GKGENERATE_24_HEX
MEND_GARAGE_KEY_SECRET=GENERATE_64_HEX

# Setup may override these to isolate more than one installation. The names in the mapping JSON
# and the Docker volumes must stay identical. The default single-instance names are canonical.
MEND_STORE_VOLUME_NAME=mend-store
MEND_CONTROL_VOLUME_NAME=mend-control
MEND_GARAGE_VOLUME_NAME=mend-garage

# Read only with compose.host-vm.yaml, the overlay for host-vm sessions: the host VM runtime's
# base disks and each VM's data disk.
MEND_VM_IMAGES_VOLUME_NAME=mend-vm-images
MEND_VM_DATA_VOLUME_NAME=mend-vm-data

# Each workspace gets a network of its own from this range. Optional beside it: private addresses
# workspaces may still reach (also the most an Access policy may allow), and the host's public
# addresses the guard refuses (empty reads auto).
MEND_WORKSPACE_EGRESS_SUBNETS=10.233.0.0/16
MEND_OPERATOR_ALLOWED_PRIVATE_EGRESS=
MEND_HOST_PUBLIC_IPS=
