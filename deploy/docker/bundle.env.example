# Copy to .env beside compose.v2.yaml. Replace every GENERATE value and chmod 600 .env.
# The setup command will generate these values; this file records its v1 hand-off contract.
MEND_VERSION=0.0.0
APP_URL=http://localhost:3105
MEND_ALLOWED_ORIGINS=[]
MEND_BIND_HOST=127.0.0.1
MEND_PORT=3105
MEND_SSH_PORT=2222
SEALANT_SSH_HOST=localhost

# Generate each password/secret as 32 random bytes encoded as lowercase hex.
MEND_POSTGRES_ADMIN_PASSWORD=GENERATE_64_HEX
MEND_DB_PASSWORD=GENERATE_64_HEX
SEALANT_DB_PASSWORD=GENERATE_64_HEX
BETTER_AUTH_SECRET=GENERATE_64_HEX
WORKSPACE_SSH_GATEWAY_TOKEN=GENERATE_64_HEX
SEALANT_SERVICE_KEY=GENERATE_WITH_PUBLIC_SEALANT_BOOTSTRAP
# Exactly 32 random bytes encoded as base64.
SEALANT_CREDENTIALS_KEY=GENERATE_32_BYTES_BASE64

# Setup may override these to isolate more than one installation. The names in the mapping JSON
# and the Docker volumes must stay identical. The default single-instance names are canonical.
MEND_STORE_VOLUME_NAME=mend-store
MEND_CONTROL_VOLUME_NAME=mend-control
