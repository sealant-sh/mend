# Copy to /opt/mend/.env on the instance, beside compose.aws.yaml, compose.edge.yaml and the
# Caddyfile. chmod 600. Values marked "tofu output" come from deploy/aws/tofu.
MEND_VERSION=0.0.0

# The public name. Its A record is DNS-only and points at tofu output instance_public_ip.
MEND_EDGE_HOST=alpha.mend.run
APP_URL=https://alpha.mend.run
SEALANT_SSH_HOST=alpha.mend.run

# First boot: single and private. After the first account exists: multi and public, then
# `docker compose -f compose.aws.yaml -f compose.edge.yaml up -d` again.
MEND_TENANCY=single
MEND_EXPOSURE=private
# The public exposure gate needs refuse. Every first-party client sends upgrade tickets.
MEND_URL_BEARERS=refuse
# Set once verified from outside the VPC (ADR 0004, items 11 and 12): core-private,edge-tls
MEND_EXPOSURE_DECLARED=
# Set to the running version once a reassessment of that release is recorded (item 13).
MEND_EXPOSURE_REASSESSED=

# PlanetScale over PrivateLink, direct port 5432, one role per database.
MEND_DATABASE_URL=postgresql://mend:PASSWORD@aws-eu-central-1-2.private-pg.psdb.cloud:5432/mend?sslmode=verify-full
SEALANT_DATABASE_URL=postgresql://sealant:PASSWORD@aws-eu-central-1-2.private-pg.psdb.cloud:5432/sealant_control_plane?sslmode=verify-full

# Captures. tofu output capture_store_url, plus the region.
AWS_REGION=eu-central-1
MEND_BLOB_STORE=s3://BUCKET?region=eu-central-1

# The session channel MicroVMs dial. tofu output instance_private_ip and
# instance_session_endpoint_url.
MEND_SESSION_BIND_HOST=10.42.0.0
MEND_SESSION_ENDPOINT_URL=http://10.42.0.0:3106

# MicroVM runtime. tofu output microvm_exec_role_arn, vpc_egress_connector_arn,
# microvm_ingress_connector_arn, microvm_exec_log_group.
# Image builds. tofu output microvm_build_role_arn, artifact_bucket, microvm_artifact_prefix,
# microvm_image_name_prefix, microvm_build_log_group. The prefix values must be the ones tofu
# prints: the instance role and the build role are granted exactly those.
SEALANT_MICROVM_BUILD_ROLE_ARN=
SEALANT_MICROVM_ARTIFACT_BUCKET=
SEALANT_MICROVM_ARTIFACT_PREFIX=
SEALANT_MICROVM_IMAGE_NAME_PREFIX=
SEALANT_MICROVM_BUILD_LOG_GROUP=
SEALANT_MICROVM_EXEC_ROLE_ARN=
SEALANT_MICROVM_EGRESS_CONNECTOR=
SEALANT_MICROVM_INGRESS_CONNECTOR=
SEALANT_MICROVM_LOG_GROUP=

# Generate each as 32 random bytes in lowercase hex, except the credentials key.
BETTER_AUTH_SECRET=GENERATE_64_HEX
WORKSPACE_SSH_GATEWAY_TOKEN=GENERATE_64_HEX
# What Sealant presents to a MicroVM's agent. The worker does not start without it.
SEALANT_CONTROL_BEARER_TOKEN=GENERATE_64_HEX
SEALANT_SERVICE_KEY=GENERATE_WITH_PUBLIC_SEALANT_BOOTSTRAP
# Exactly 32 random bytes encoded as base64.
SEALANT_CREDENTIALS_KEY=GENERATE_32_BYTES_BASE64
