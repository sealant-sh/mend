# The edge for a packaged Mend install (docs/adr/0004-access-without-a-private-network.md).
# TLS ends here: Caddy obtains and renews a certificate for MEND_EDGE_HOST and redirects port 80.
# Everything goes to Mend's web tier, which proxies /api, the event stream and every WebSocket on
# this one origin. Nothing else is routed: not the API, not Sealant, not the session channel, not
# the bucket.
#
# What a log line about a request holds. Mend's site names its log `mend`, and only that log keeps
# a path: never a query or a fragment, whatever route it names (sockets and the phone's embed carry
# a single-use ticket there, pairing a code), nor a target's userinfo, in the uri or a Location.
# Nor the segment after a path whose next segment is a secret, in any case and with any number of
# slashes (SECRET_SEGMENT_PREFIXES in packages/network): a link to /join, /reset or /slack/link in
# the path form issued before 0.37, a CLI sign-in's /api/me/cli-auth, a released phone's
# /api/devices, and Better Auth's /api/auth/reset-password. Behind userinfo that segment is dropped.
# A path a dot segment, a ;, a backslash or a leading // makes unclassifiable keeps only its first /
# (its //, for a leading //), behind userinfo too: such a path can name any of those.
# Every other line holds no uri and no Location: the t3code gateway's (an asset URL's path is its
# token and file name), and every line Caddy does not name for Mend's site. Caddy names a line's
# log by the exact Host, so a Host in another case or with a trailing dot, the port-80 redirect for
# it, and a module's own lines (reverse_proxy's for a response cut short) fall to `default`.
# Caddy already redacts Authorization, Cookie and Set-Cookie; Referer is dropped, and so is
# X-Mend-Invitation, the invitation token a sign-up from /join#<token> carries.
(uri-free) {
	format filter {
		fields {
			request>uri replace REDACTED
			resp_headers>Location delete
			request>headers>Referer delete
			request>headers>X-Mend-Invitation delete
		}
	}
}

{
	log default {
		output stdout
		import uri-free
	}
	log mend {
		include http.log.access.mend http.log.error.mend
		output stdout
		format filter {
			fields {
				request>uri regexp "(^//)[\s\S]*|(^(?:[A-Za-z][A-Za-z0-9+.-]*://[^/?#@]*)?/)(?:/|(?:[^?#]*?/)?(?:\.|%2[eE])(?:\.|%2[eE])?(?:[/?#]|$)|[^?#]*?(?:[;\x5c]|%5[cC]))[\s\S]*|(^|[A-Za-z][A-Za-z0-9+.-]*://)[^/?#]*(@)(?:([^/?#]*/)(?:/|(?:[^?#]*?/)?(?:\.|%2[eE])(?:\.|%2[eE])?(?:[/?#]|$)|[^?#]*?(?:[;\x5c]|%5[cC]))[\s\S]*|([^/?#]*/+(?i:join|reset|slack/+link|api/+me/+cli-auth|api/+devices|api/+auth/+reset-password)/+)[^/?#]+)?|([?#])[\s\S]*|(^(?:[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*)?/+(?i:join|reset|slack/+link|api/+me/+cli-auth|api/+devices|api/+auth/+reset-password)/+)[^/?#]+" "${1}${2}${3}${7}${8}REDACTED${4}${5}${6}"
				resp_headers>Location regexp "(^//)[\s\S]*|(^(?:[A-Za-z][A-Za-z0-9+.-]*://[^/?#@]*)?/)(?:/|(?:[^?#]*?/)?(?:\.|%2[eE])(?:\.|%2[eE])?(?:[/?#]|$)|[^?#]*?(?:[;\x5c]|%5[cC]))[\s\S]*|(^|[A-Za-z][A-Za-z0-9+.-]*://)[^/?#]*(@)(?:([^/?#]*/)(?:/|(?:[^?#]*?/)?(?:\.|%2[eE])(?:\.|%2[eE])?(?:[/?#]|$)|[^?#]*?(?:[;\x5c]|%5[cC]))[\s\S]*|([^/?#]*/+(?i:join|reset|slack/+link|api/+me/+cli-auth|api/+devices|api/+auth/+reset-password)/+)[^/?#]+)?|([?#])[\s\S]*|(^(?:[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*)?/+(?i:join|reset|slack/+link|api/+me/+cli-auth|api/+devices|api/+auth/+reset-password)/+)[^/?#]+" "${1}${2}${3}${7}${8}REDACTED${4}${5}${6}"
				request>headers>Referer delete
				request>headers>X-Mend-Invitation delete
			}
		}
	}
}

{$MEND_EDGE_HOST} {
	encode zstd gzip

	# The raw route's file headers are for the t3code gateway, which reads Mend over loopback, never
	# through this edge.
	header -X-Mend-File-*

	# Mend's web tier deletes inbound Forwarded, X-Forwarded-Host and X-Forwarded-Proto and appends
	# the address it saw to X-Forwarded-For. Caddy sets X-Forwarded-For to the client it accepted;
	# it does not trust one a client sent, since no trusted_proxies are configured above it.
	reverse_proxy mend:3105 {
		# Terminals and the event stream are long-lived: never buffer, never time them out.
		flush_interval -1
	}

	log mend
}

# Sites beside Mend's own origin, one file each. `mend server setup --t3-gateway-origin <host>`
# mounts the t3code gateway's here (docs/adr/0012); none is there unless one was asked for.
import /etc/caddy/sites/*.caddy
