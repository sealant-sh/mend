{
  "name": "@mend/slack",
  "version": "0.0.0",
  "private": true,
  "description": "Slack for Mend (docs/adr/0006-slack.md): the app manifest, mention parsing, repository matching, thread context and message formatting as pure functions, and `./client`, the Web API behind the SlackApi service",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./socket": "./src/socket.ts"
  },
  "scripts": {
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mend/domain": "workspace:*",
    "@slack/socket-mode": "catalog:",
    "@slack/web-api": "catalog:",
    "effect": "catalog:",
    "undici": "catalog:"
  },
  "devDependencies": {
    "@mend/typescript": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
