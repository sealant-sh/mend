{
  "name": "@mend/t3-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "t3code's contracts at a pinned tag, copied verbatim (MIT, T3 Tools Inc.), for the t3code gateway",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client-rpc-permissions": "./src/clientRpcPermissions.ts",
    "./keybindings": "./t3-shared/src/keybindings.ts",
    "./pending-background-work": "./t3-shared/src/orchestrationV2PendingBackgroundWork.ts",
    "./pin": "./t3code.pin.json",
    "./relay": "./src/relay.ts",
    "./server-settings": "./t3-shared/src/serverSettings.ts",
    "./settings": "./src/settings.ts",
    "./thread-find-text": "./t3-shared/src/threadFindText.ts",
    "./thread-search": "./t3-shared/src/threadSearch.ts",
    "./thread-settled": "./client-runtime/threadSettled.ts",
    "./thread-transcript": "./t3-shared/src/threadTranscript.ts"
  },
  "scripts": {
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "sync": "node scripts/sync.ts",
    "test": "vitest run",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@t3tools/contracts": "link:.",
    "@t3tools/shared": "link:./t3-shared",
    "effect": "catalog:",
    "mdast-util-directive": "catalog:t3",
    "micromark-extension-directive": "catalog:t3",
    "micromark-util-character": "catalog:t3",
    "micromark-util-types": "catalog:t3",
    "rehype-raw": "catalog:t3",
    "rehype-sanitize": "catalog:t3",
    "remark-breaks": "catalog:t3",
    "remark-gfm": "catalog:t3",
    "remark-parse": "catalog:t3",
    "remark-rehype": "catalog:t3",
    "unified": "catalog:t3"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@mend/test-ci": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
