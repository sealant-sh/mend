{
  "name": "@mend/network",
  "version": "0.0.0",
  "private": true,
  "description": "Mend's explicit public URL and browser-origin configuration",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./address-kind": "./src/address-kind.ts",
    "./handed-links": "./src/handed-links.ts",
    "./http-observation": "./src/http-observation.ts",
    "./secret-segments": "./src/secret-segments.ts",
    "./url-template": "./src/url-template.ts",
    "./tunnel-client": "./src/tunnel-client.ts"
  },
  "scripts": {
    "lint": "OXLINT_TSGOLINT_PATH=../../node_modules/.bin/tsrs-lint oxlint --type-aware . --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsrs -p tsconfig.json --noEmit --checkers 1"
  },
  "dependencies": {
    "effect": "catalog:",
    "tldts": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@mend/test-ci": "workspace:*",
    "@mend/typescript": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
