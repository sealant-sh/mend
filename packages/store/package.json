{
  "name": "@mend/store",
  "version": "0.0.0",
  "private": true,
  "description": "Mend's central repository store: bare clones, per-session worktrees, checkpoint refs — pure git on the host",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./test/capture-fixture.ts"
  },
  "scripts": {
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@mend/domain": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@mend/typescript": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
