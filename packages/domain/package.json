{
  "name": "@mend/domain",
  "version": "0.0.0",
  "private": true,
  "description": "Mend domain models — workbench (project, session, change, checkpoint) plus the retiring queue-era set",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./workbench": "./src/workbench/index.ts",
    "./host-user-namespaces": "./src/workbench/host-user-namespaces.ts",
    "./default-login": "./src/workbench/default-login.ts",
    "./endpoint-url": "./src/workbench/endpoint-url.ts",
    "./runtime-support-fixtures": "./src/runtime-support-fixtures.ts",
    "./boat-key-fixtures": "./src/workbench/boat-key-fixtures.ts"
  },
  "scripts": {
    "lint": "OXLINT_TSGOLINT_PATH=../../node_modules/.bin/tsrs-lint oxlint --type-aware . --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsrs -p tsconfig.json --noEmit --checkers 1"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@sealant/api-contracts": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@mend/test-ci": "workspace:*",
    "@mend/typescript": "workspace:*",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
