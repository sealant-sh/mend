{
  "name": "@mend/db",
  "version": "0.0.0",
  "private": true,
  "description": "Postgres access for Mend: Effect Drizzle client, migrations, repositories",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./test/postgres.ts"
  },
  "scripts": {
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/sql-pg": "catalog:",
    "@mend/api-contracts": "workspace:*",
    "@mend/domain": "workspace:*",
    "@mend/sealant": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@mend/typescript": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
