{
  "name": "@mend/local-git",
  "version": "0.0.0",
  "private": true,
  "description": "Git on the person's machine: the handoff snapshot, the origin rule and the agent share",
  "type": "module",
  "exports": {
    "./agent-share": "./src/agent-share.ts",
    "./handoff": "./src/handoff.ts",
    "./origin": "./src/origin.ts",
    "./testing": "./test/testing.ts"
  },
  "scripts": {
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mend/domain": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@mend/test-ci": "workspace:*",
    "@mend/typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
  }
}
