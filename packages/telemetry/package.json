{
  "name": "@mend/telemetry",
  "version": "0.0.0",
  "private": true,
  "description": "Mend's servers' traces, logs and errors to Sentry: off unless the process is given a DSN",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./span-names": "./src/span-names.ts",
    "./url-template": "./src/url-template.ts"
  },
  "scripts": {
    "lint": "OXLINT_TSGOLINT_PATH=../../node_modules/.bin/tsrs-lint oxlint --type-aware . --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsrs -p tsconfig.json --noEmit --checkers 1"
  },
  "dependencies": {
    "@mend/api-contracts": "workspace:*",
    "@mend/network": "workspace:*",
    "@sentry/core": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@mend/test-ci": "workspace:*",
    "@mend/typescript": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
