    "@mend/store": "workspace:*",
    "@sealant/sdk": "catalog:",
    "effect": "catalog:",
    "parse5": "8.0.1",
    "smol-toml": "1.4.2"
  },
  "devDependencies": {
    "@effect/sql-pg": "catalog:",
    "@effect/vitest": "catalog:",
    "@mend/test-ci": "workspace:*",
    "@mend/typescript": "workspace:*",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
