{
  "name": "mend",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo build",
    "changeset": "changeset",
    "clean": "pnpm run clean:workspaces && rm -rf node_modules .turbo",
    "clean:turbo": "turbo clean",
    "clean:workspaces": "pnpm -r --parallel exec rm -rf node_modules .turbo",
    "dev": "pnpm --filter @mend/web dev",
    "dev:all": "turbo dev --ui=tui",
    "format": "oxfmt . --check",
    "format:check": "oxfmt . --check",
    "format:fix": "oxfmt .",
    "lint": "turbo lint --ui=tui",
    "lint:fix": "oxlint . --fix",
    "lint:types": "oxlint . --type-aware --type-check",
    "test": "turbo test",
    "test:watch": "vitest",
    "typecheck": "turbo typecheck --ui=tui",
    "version-packages": "changeset version && node scripts/sync-chart-version.mjs && pnpm format:fix"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260315.1",
    "effect-solutions": "^0.5.2",
    "oxfmt": "^0.40.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "^0.17.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
