{
  "name": "mend",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo build",
    "changeset": "changeset",
    "clean": "pnpm run clean:workspaces && rm -rf node_modules .turbo",
    "clean:workspaces": "pnpm -r --parallel exec rm -rf node_modules .turbo",
    "dev": "pnpm --filter @mend/web dev",
    "dev:all": "turbo dev --ui=tui",
    "format": "oxfmt . --check",
    "format:check": "oxfmt . --check",
    "format:fix": "oxfmt .",
    "lint": "turbo lint --ui=tui",
    "lint:fix": "oxlint . --fix",
    "lint:types": "OXLINT_TSGOLINT_PATH=node_modules/.bin/tsrs-lint oxlint . --type-aware --type-check",
    "test": "turbo test",
    "test:aws-shell": "bash deploy/aws/kubernetes/smoke.test.sh && bash deploy/aws/scripts/build-workspace-image.test.sh",
    "test:s3-contract": "node scripts/test-s3-contract.mjs",
    "test:watch": "vitest",
    "typecheck": "turbo typecheck --ui=tui",
    "version-packages": "changeset version && node scripts/sync-chart-version.mjs && pnpm format:fix"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@changesets/cli": "^2.31.0",
    "@tanstack/intent": "^0.5.6",
    "@types/node": "catalog:",
    "@typescript/typescript6": "catalog:",
    "oxfmt": "^0.40.0",
    "oxlint": "1.76.0",
    "tsrs": "0.24.0-ts7.1.0-beta",
    "turbo": "2.11.9",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "intent": {
    "skills": [
      "@tanstack/*",
      "@trpc/*"
    ]
  }
}
